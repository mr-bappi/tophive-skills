{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Future verified aggregate analytics for TOPHIVE Skills Examples",
  "description": "No metrics are collected or shown until a verified provider integration is implemented. Never invent public numbers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "products"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "products": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "periodStart",
          "periodEnd",
          "updatedAt"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "periodStart": {
            "type": "string",
            "format": "date"
          },
          "periodEnd": {
            "type": "string",
            "format": "date"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "pageViews": {
            "type": "integer",
            "minimum": 0
          },
          "downloads": {
            "type": "integer",
            "minimum": 0
          },
          "methodology": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
